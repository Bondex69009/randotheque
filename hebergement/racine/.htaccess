# randotheque.anthony-bondon.fr : racine du sous-domaine (envoyée par le workflow « Serveur de statistiques »).
# Sous-dossiers : /godillots-ailes/ et /gerard-martine/ (les deux sites), /stats/ (serveur de statistiques).
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Outil interne : jamais indexé par les moteurs de recherche.
<IfModule mod_headers.c>
	Header set X-Robots-Tag "noindex, nofollow"
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
	AddType application/gpx+xml .gpx
	AddType application/manifest+json .webmanifest
</IfModule>

# Pages HTML et données : toujours revalidées (mises à jour toutes les heures).
<IfModule mod_headers.c>
	<FilesMatch "\.(html|json|js|css|webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	<FilesMatch "^sw\.js$">
		Header set Cache-Control "no-cache, no-store"
	</FilesMatch>
</IfModule>
