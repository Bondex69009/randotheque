# Statistiques des Randothèques (dossier /stats/ du sous-domaine).
#   collect.php  public : reçoit les visites des deux sites
#   (les tableaux de bord sont dans godillots-ailes/stats/ et gerard-martine/stats/)
#   lib/, data/, config.php : jamais accessibles depuis le web
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
	RewriteRule ^(lib|data)(/|$) - [F,L]
	RewriteRule ^config\.php$ - [F,L]
</IfModule>

<FilesMatch "^config\.php$">
	Require all denied
</FilesMatch>
